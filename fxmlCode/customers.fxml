<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.demo2.CustomerListController">
    <children>
        <VBox spacing="10" layoutX="20.0" layoutY="20.0" prefWidth="600" prefHeight="400">
            <Label text="Customer List" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            <TableView fx:id="customerTable" prefHeight="350" prefWidth="560">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="nameCol" text="Name" prefWidth="120"/>
                    <TableColumn fx:id="phoneCol" text="Phone" prefWidth="120"/>
                    <TableColumn fx:id="addressCol" text="Address" prefWidth="140"/>
                    <TableColumn fx:id="nidCol" text="NID" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
