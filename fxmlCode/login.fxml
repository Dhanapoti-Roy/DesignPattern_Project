<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo2.LoginController">
    <children>
        <VBox alignment="CENTER" layoutY="-12.0" prefHeight="231.0" prefWidth="232.0" spacing="15.0" style="-fx-background-color: BLUE;">
            <padding><Insets bottom="20" left="40" right="40" top="20" /></padding>

            <Label text="Login System">
                <font>
                    <Font size="24" />
                </font>
            </Label>

            <TextField fx:id="usernameField" promptText="Username" />
            <PasswordField fx:id="passwordField" promptText="Password" />

            <Button fx:id="loginButton" onAction="#handleLogin" text="Login" />

            <Label fx:id="errorLabel" textFill="red" />
        </VBox>
    </children>
</AnchorPane>
